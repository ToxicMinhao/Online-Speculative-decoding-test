"""Read-only complete-state, source and runtime validation; no optimizer steps."""
import json
from pathlib import Path
import sys
import time
from online_feedback.storage import write_json
from experiments.osd_components.prepare import verify_native_runtime
from experiments.ok_continuation.resume import load_snapshot
from campaign import identity, validate_plan, admit_phase


def verify(root,postflight=False):
    root=Path(root); started=time.perf_counter()
    seal=json.loads((root/'sealed/SEAL.json').read_text())
    for folder,expected in seal['exact_file_sets'].items():
        if sorted(p.name for p in Path(folder).iterdir() if p.is_file())!=expected:
            raise ValueError('Retained exact file set differs: '+folder)
    for name,expected in seal['files'].items():
        if identity(name)!=expected: raise ValueError('Sealed artifact changed: '+name)
    plan=json.loads((root/'sealed/PLAN.json').read_text());validate_plan(plan)
    receipt=dict(status='passed',files_checked=len(seal['files']))
    if not postflight:
        receipt['runtime']=verify_native_runtime(plan['worker_python'],
            json.loads((root/'sealed/RUNTIME_PIN.json').read_text()))
        receipt['parents']={}
        for arm,p in plan['initial'].items():
            state,summary=load_snapshot(p['state'],p['export'],objective={'O':'osd','K':'osd_first_error'}[arm],
                                       config_text=Path(plan['config']).read_text(),completed_event=1)
            receipt['parents'][arm]=summary
            del state
        receipt['initial_storage']=admit_phase(root,'initial_collection',
            rows=sum(len(r['prompt_ids'])+2048 for r in plan['windows'][0]['requests']))
    receipt['wall_s']=time.perf_counter()-started
    write_json(root/('POSTFLIGHT.json' if postflight else 'PREFLIGHT.json'),receipt)
    return receipt


if __name__=='__main__':
    print(json.dumps(verify(sys.argv[1],postflight='--postflight' in sys.argv[2:])))
