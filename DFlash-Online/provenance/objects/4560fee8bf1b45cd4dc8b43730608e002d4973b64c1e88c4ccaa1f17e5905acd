def feature(record='r1', response=(4, 5)):
    ids = [1, 2, *response]
    return {'record_id': record, 'input_ids': torch.tensor([ids], dtype=torch.long),
            'loss_mask': torch.tensor([[0, 0, *([1] * len(response))]]),
            'hidden_states': torch.ones(1, len(ids), 3), 'prompt_length': 2,
            'input_sha256': T.token_sha(ids), 'response_sha256': T.token_sha(response)}


class FeatureTests(unittest.TestCase):
    def check(self, raw, cap=4): return T.validate_feature(raw, max_length=cap, hidden_width=3, vocab_size=32)
    def test_exact_response_and_lengths(self):
        self.assertEqual(self.check(feature())['adjacent_response_positions'], 1)
    def test_overlength_rejected_before_truncation(self):
        with self.assertRaisesRegex(ValueError, 'truncation'): self.check(feature(), 3)
    def test_one_token_response_rejected(self):
        with self.assertRaises(ValueError): self.check(feature(response=(4,)))
    def test_prompt_or_incomplete_response_mask_rejected(self):
        for pos in (0, 2):
            raw=feature();raw['loss_mask'][0,pos]=1-raw['loss_mask'][0,pos]
            with self.assertRaises(ValueError): self.check(raw)
    def test_changed_token_identity_rejected(self):
        raw=feature();raw['input_ids'][0,3]=8
        with self.assertRaises(ValueError): self.check(raw)
    def test_feature_width_and_nonfinite_rejected(self):
        raw=feature();raw['hidden_states'][0,0,0]=float('nan')
        with self.assertRaises(ValueError): self.check(raw)
        raw=feature();raw['hidden_states']=torch.ones(1,4,4)
        with self.assertRaises(ValueError): self.check(raw)
    def test_extra_batch_dimension_or_misalignment_rejected(self):
        raw=feature();raw['input_ids']=raw['input_ids'][0]
        with self.assertRaises(ValueError): self.check(raw)
        raw=feature();raw['hidden_states']=torch.ones(1,3,3)
        with self.assertRaises(ValueError): self.check(raw)


class ScalarStrategy:
    name='dflash'
    def __init__(self, model): self.model=model;self.calls=0
    def forward_loss(self,batch,ctx=None):
        self.calls+=1
        label=batch.tensors['input_ids'][0,-1].float()
        loss=(self.model.draft_model.weight.float().reshape(())-label).square()
        weight=label.detach()
        return StepOutput(loss,{},loss_terms=(loss*weight,weight))
    def checkpoint_state_filter(self,state):
        return {k.removeprefix('draft_model.'):v for k,v in state.items() if k.startswith('draft_model.')}


class GradientBackend:
    checks_loss_denominator=False
    def __init__(self,p):self.p=p;self.last=None
    def backward(self,loss,**kw):loss.backward()
    def scale_gradients(self,factor):self.p.grad.mul_(factor)
    def step(self):self.last=self.p.grad.item();return None


class ReductionTests(unittest.TestCase):
    def gradient(self,mode):
        model=torch.nn.Module();model.target_table=torch.nn.Parameter(torch.tensor([0.3]),requires_grad=False);model.draft_model=torch.nn.Linear(1,1,bias=False);model.draft_model.weight.data.zero_()
        strategy=ScalarStrategy(model);backend=GradientBackend(model.draft_model.weight)
        core=TrainerCore(T.ReductionAdapter(strategy,mode),backend,accumulation_steps=2)
        for token in (1,3):
            batch=SimpleNamespace(tensors={'input_ids':torch.tensor([[token]])})
            result=core.train_step(batch)
        self.assertEqual(strategy.calls,2);self.assertEqual(core.accumulation_remainder,0)
        self.assertEqual(result.metrics['response_presentations'],2)
        return backend.last,result.metrics
    def test_response_mean_uses_equal_response_weights(self):
        grad,metrics=self.gradient('response_mean');self.assertAlmostEqual(grad,-4)
        self.assertAlmostEqual(metrics['loss'],5)
        self.assertAlmostEqual(metrics['author_weighted_objective'],7)
    def test_upstream_weight_mean_keeps_author_ratio(self):
        grad,metrics=self.gradient('upstream_weight_mean');self.assertAlmostEqual(grad,-5)
        self.assertAlmostEqual(metrics['loss'],7)
    def test_unknown_reduction_rejected(self):
        with self.assertRaises(ValueError):T.ReductionAdapter(None,'silent_default')


class TinyTrainer(T.SpecForgeEventTrainer):
    def _build_runtime(self):
        torch.manual_seed(17);random.seed(17);np.random.seed(17)
        self.horizon=4;self.accumulation=2;self.max_length=16;self.hidden_width=3;self.vocab_size=32
        self.contract={'tiny_cpu_contract':True}
        self.cfg=SimpleNamespace(run_id='cpu',model=SimpleNamespace(draft_model_config=str(self.config_path),target_model_path='unused',embedding_key='unused'))
        model=torch.nn.Module();model.target_table=torch.nn.Parameter(torch.tensor([0.3]),requires_grad=False);model.draft_model=torch.nn.Linear(1,1,bias=False).to(torch.bfloat16)
        self.bundle=SimpleNamespace(model=model,draft_model=model.draft_model)
        factory=lambda draft:BF16Optimizer(draft,lr=0.01,total_steps=4,warmup_ratio=0,lr_scheduler='constant',offload_master=True,max_grad_norm=10)
        self.backend=FSDPTrainingBackend(ParallelConfig(sharding_strategy='NO_SHARD'),optimizer_factory=factory)
        self.backend.prepare_model(model,wrap=False,optimizer_target=model.draft_model)
        self.author_strategy=ScalarStrategy(model);self.strategy=T.ReductionAdapter(self.author_strategy,self.reduction)
        self.core=TrainerCore(self.strategy,self.backend,accumulation_steps=2);self._anchor_observations=[]


def exact(a,b):
    if isinstance(a,torch.Tensor):return isinstance(b,torch.Tensor) and a.dtype==b.dtype and torch.equal(a,b)
    if isinstance(a,np.ndarray):return isinstance(b,np.ndarray) and np.array_equal(a,b)
    if isinstance(a,dict):return a.keys()==b.keys() and all(exact(a[k],b[k]) for k in a)
    if isinstance(a,(tuple,list)):return type(a)==type(b) and len(a)==len(b) and all(exact(x,y) for x,y in zip(a,b))
    return a==b


class PersistenceTests(unittest.TestCase):
    def setUp(self):
        self.tmp=tempfile.TemporaryDirectory();self.root=Path(self.tmp.name)
        self.cfg=self.root/'config.json';self.cfg.write_text('{}')
        self.features=[]
        for i in range(2):
            p=self.root/f'f{i}.pt';torch.save(feature(f'r{i}',response=(4,5+i)),p);self.features.append(p)
        def export(state,config,out,**kw):
            Path(out).mkdir();(Path(out)/'model.safetensors').write_bytes(b'fixture export')
            torch.rand(3);random.random();np.random.rand()  # publication must restore these RNGs
        self.export=mock.patch('specforge.export.to_hf.export_to_hf',side_effect=export);self.export.start()
        self.rank_logger=mock.patch('specforge.optimizer.print_on_rank0');self.rank_logger.start()
    def tearDown(self):self.rank_logger.stop();self.export.stop();self.tmp.cleanup()
    def trainer(self,name='run',resume=None):return TinyTrainer(self.cfg,self.root/name,resume_state=resume)
    def test_two_events_keep_optimizer_master_and_scheduler(self):
        c=self.trainer();optimizer=c.backend.optimizer;master=optimizer.fp32_params[0]
        first=c.train_event('e1',self.features);second=c.train_event('e2',self.features)
        self.assertIs(c.backend.optimizer,optimizer);self.assertIs(optimizer.fp32_params[0],master)
        self.assertEqual(c.global_step,4);self.assertEqual(c.presentations,8)
        self.assertEqual(first['optimizer_steps'],2);self.assertEqual(second['optimizer_steps'],2)
        self.assertEqual([x['record_id'] for x in first['records']],['r0','r1','r0','r1'])
        self.assertEqual(float(optimizer.optimizer.state[master]['step']),4)
        self.assertTrue(c.latest.is_file());self.assertFalse(c.pending_state.exists())
    def test_frozen_target_and_parameter_norms_recorded(self):
        c=self.trainer();row=c.train_event('e1',self.features);audit=row['parameter_audit']
        self.assertTrue(audit['frozen_unchanged']);self.assertEqual(len(audit['before']['frozen_parameters']),1)
        self.assertNotEqual(audit['draft_l2_norm_change'],0);self.assertNotEqual(audit['fp32_master_l2_norm_change'],0)
    def test_non_draft_trainable_parameter_refused(self):
        c=self.trainer();c.bundle.model.target_table.requires_grad_(True)
        with self.assertRaisesRegex(ValueError,'Non-draft'):c.train_event('bad',self.features)
        self.assertEqual(c.global_step,0)
    def test_frozen_target_mutation_refuses_publication(self):
        c=self.trainer();original=c.core.train_step
        def step(*args,**kwargs):
            result=original(*args,**kwargs);c.bundle.model.target_table.data.add_(1);return result
        with mock.patch.object(c.core,'train_step',side_effect=step):
            with self.assertRaisesRegex(ValueError,'Frozen target'):c.train_event('bad',self.features)
        self.assertFalse(c.latest.exists());self.assertTrue(c.failed)
    def test_restart_event2_matches_uninterrupted_exactly(self):
        a=self.trainer('a');a.train_event('e1',self.features)
        saved=self.root/'saved.pt';saved.write_bytes(a.latest.read_bytes())
        a.train_event('e2',self.features);expected=torch.load(a.latest,weights_only=False)
        b=self.trainer('b',saved);b.train_event('e2',self.features);actual=torch.load(b.latest,weights_only=False)
        for key in ('draft_state_dict','backend','extra_rng','global_step','presentations'):
            self.assertTrue(exact(expected[key],actual[key]),key)
    def test_immediate_restart_fingerprint_and_release(self):
        a=self.trainer('a');a.train_event('e1',self.features);before=a.state_fingerprint()
        saved=self.root/'saved.pt';saved.write_bytes(a.latest.read_bytes());a.close()
        self.assertTrue(a.status()['closed']);self.assertFalse(hasattr(a,'bundle'));self.assertFalse(hasattr(a,'core'))
        b=self.trainer('b',saved);self.assertEqual(before['hashes'],b.state_fingerprint()['hashes'])
        b.backend.optimizer.fp32_params[0].data.add_(1)
        self.assertNotEqual(before['hashes']['optimizer_masters_scheduler'],b.state_fingerprint()['hashes']['optimizer_masters_scheduler'])
    def test_duplicate_event_refused_without_parameter_change(self):
        c=self.trainer();c.train_event('e1',self.features);before=c.bundle.draft_model.weight.detach().clone()
        with self.assertRaisesRegex(ValueError,'Duplicate'):c.train_event('e1',self.features)
        self.assertTrue(torch.equal(before,c.bundle.draft_model.weight))
    def test_partial_window_and_horizon_refused_before_training(self):
        c=self.trainer()
        with self.assertRaisesRegex(ValueError,'remainder'):c.train_event('bad',self.features[:1],passes=1)
        with self.assertRaisesRegex(ValueError,'horizon'):c.train_event('bad2',self.features,passes=5)
        self.assertEqual(c.global_step,0);self.assertFalse(list(c.events_root.iterdir()))
    def test_duplicate_response_refused(self):
        c=self.trainer()
        with self.assertRaisesRegex(ValueError,'Duplicate response'):c.train_event('bad',[self.features[0]]*2)
    def test_config_change_refused(self):
        c=self.trainer();self.cfg.write_text('{"changed":true}')
        with self.assertRaisesRegex(ValueError,'Configuration changed'):c.train_event('bad',self.features)
    def test_changed_reduction_refuses_resume(self):
        c=self.trainer();c.train_event('e1',self.features)
        with self.assertRaisesRegex(ValueError,'reduction'):TinyTrainer(self.cfg,self.root/'other',resume_state=c.latest,reduction='upstream_weight_mean')
    def test_uncommitted_event_blocks_restart(self):
        c=self.trainer();c.train_event('e1',self.features);(c.events_root/'unfinished').mkdir()
        with self.assertRaisesRegex(ValueError,'Uncommitted event'):self.trainer(resume=c.latest)
    def test_export_failure_keeps_prior_committed_state(self):
        c=self.trainer();c.train_event('e1',self.features);before=T.file_sha(c.latest)
        with mock.patch('specforge.export.to_hf.export_to_hf',side_effect=OSError('copy failure')):
            with self.assertRaises(OSError):c.train_event('e2',self.features)
        self.assertEqual(T.file_sha(c.latest),before);self.assertTrue(c.failed);self.assertTrue(c.pending_state.exists())
        with self.assertRaises(ValueError):c.train_event('retry',self.features)

