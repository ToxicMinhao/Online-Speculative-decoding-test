#!/usr/bin/env bash
set -eu
source /data/sources/minhao/EAGLE_SPEC/setup/a800/a800_env.sh
cd /data/sources/minhao/DFlash-Online
if [ -n "${CUDA_VISIBLE_DEVICES:-}" ] && [ "$CUDA_VISIBLE_DEVICES" != '1' ]; then
    echo 'Inherited allocation differs; preserve it and stop.' >&2
    exit 1
fi
if [ -n "$(nvidia-smi --query-compute-apps=pid --format=csv,noheader)" ]; then
    echo 'GPU jobs active; qualification and timing require isolation.' >&2
    exit 1
fi
export CUDA_VISIBLE_DEVICES=1 PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH=/data/sources/minhao/DFlash-Online:/data/sources/minhao/DFlash-Online/training:/data/sources/minhao/DFlash-Online/inference
export PATH=/data/conda_envs/minhao/dflash_specforge_20261022/bin:$PATH
export CONDA_PREFIX=/data/conda_envs/minhao/dflash_specforge_20261022
export CC=/data/conda_envs/minhao/dflash_tree_qualification_v2/bin/x86_64-conda-linux-gnu-gcc
export CXX=/data/conda_envs/minhao/dflash_tree_qualification_v2/bin/x86_64-conda-linux-gnu-g++
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=false
guard_root=/data/sources/minhao/runs/dflash_prefix_preservation_guard_20261027/repair_002
CUDA_VISIBLE_DEVICES='' python "$guard_root/preflight.py" "$guard_root"
CUDA_VISIBLE_DEVICES='' OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 \
  PYTHONPATH="$PYTHONPATH:/data/sources/minhao/DFlash-Online/tests:$guard_root" \
  python -m unittest discover -s /data/sources/minhao/DFlash-Online/tests -v \
  > "$guard_root/CPU_REGRESSION_REMOTE.log" 2>&1
(cd "$guard_root" && CUDA_VISIBLE_DEVICES='' OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 \
  PYTHONPATH="$PYTHONPATH:/data/sources/minhao/DFlash-Online/tests" python -m unittest test_prefix_guard test_prefix_guard_qualification -v \
  > "$guard_root/CPU_FOCUSED_REMOTE.log" 2>&1)
set +e
python -u "$guard_root/qualify_only.py" "$guard_root"
qualification_status=$?
CUDA_VISIBLE_DEVICES='' python "$guard_root/preflight.py" "$guard_root" --postflight > "$guard_root/POSTFLIGHT.log" 2>&1
postflight_status=$?
if [ "$qualification_status" -ne 0 ]; then exit "$qualification_status"; fi
exit "$postflight_status"
