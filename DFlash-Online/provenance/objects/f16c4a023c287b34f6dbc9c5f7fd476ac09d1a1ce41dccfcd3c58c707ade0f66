    def test_preservation_pass_does_not_hide_nonzero_supervisor_exit(self):
        root = self.root / 'provenance'
        root.mkdir()
        (root / 'config.yaml').write_text('TEST_ONLY_CONFIG\n')
        remote_o, remote_config = '/TEST_ONLY/retained/RESULT.json', '/TEST_ONLY/config.yaml'
        q = dict(ordinary_receipt=remote_o, config=remote_config,
                 input_sha256={remote_o: audit.digest(ORDINARY), remote_config: audit.digest(root / 'config.yaml')})
        write(root / 'qualification/RESULT.json', q)
        seal = dict(source_sha256={'source.py': 'abc'}, execution_sha256={'run.py': 'def'}, dependency_sha256={})
        postflight = dict(status='passed', errors=[], supervisor_exit_code=9,
            checked=dict(source_sha256=1, execution_sha256=1, dependency_sha256=0, retained_artifacts=1))
        write(root / 'SEAL.json', seal)
        write(root / 'POSTFLIGHT.json', postflight)
        write(root / 'PREFLIGHT.json', dict(status='passed', original_inputs_unchanged=True,
            storage=dict(admitted=True), retained_artifacts=1))
        write(root / 'RETAINED_ARTIFACTS.json', {remote_o: dict(sha256=audit.digest(ORDINARY))})
        args = SimpleNamespace(ordinary_receipt=ORDINARY, seal=root / 'SEAL.json', postflight=root / 'POSTFLIGHT.json')
        issues = []
        audit.provenance(root, args, issues)
        self.assertEqual(issues, ['Postflight preservation AND supervisor completion'])
        postflight['supervisor_exit_code'] = 0
        write(root / 'POSTFLIGHT.json', postflight)
        issues = []
        audit.provenance(root, args, issues)
        self.assertEqual(issues, [])

    def test_missing_inputs_exit_nonzero_with_failed_receipt(self):
        output = self.root / 'missing_audit.json'
        command = [sys.executable, str(SCRIPT)]
        for name in ('campaign', 'manifest', 'ordinary-receipt', 'ordinary-measurements', 'seal', 'postflight'):
            command += ['--' + name, str(self.root / 'missing')]
        command += ['--output', str(output)]
        result = subprocess.run(command, capture_output=True, text=True)
        self.assertEqual(result.returncode, 1)
        self.assertEqual(audit.read(output)['status'], 'failed')


