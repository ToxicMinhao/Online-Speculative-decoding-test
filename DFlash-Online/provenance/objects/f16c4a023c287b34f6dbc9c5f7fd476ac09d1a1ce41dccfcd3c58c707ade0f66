    def test_pooled_ratios_use_repeat_zero_counts_and_all_four_axes(self):
        rows = []
        values = {'O': (1, 9), 'C': (2, 10), 'K': (1, 3), 'A': (3, 5)}
        for rid in range(2):
            for arm in audit.ARMS:
                for repeat, scale in enumerate((.5, 1., 1.5)):
                    calls = values[arm][rid]
                    rows.append(dict(request_id=str(rid), method=arm, repeat=repeat,
                        verification_calls=calls, accepted_draft_tokens=80, committed_progress=99,
                        output_tokens=100, request_latency_s=scale*calls))
        totals, comparisons = audit.independent_totals(rows, ['0', '1'])
        self.assertEqual(totals['O']['verification_calls'], 10)
        self.assertEqual(totals['O']['all_repeats_request_latency_s'], 30)
        self.assertEqual(comparisons['K_vs_O']['call_reduction_pct'], 60)
        self.assertAlmostEqual(comparisons['A_vs_C']['call_reduction_pct'], 100/3)
        self.assertAlmostEqual(comparisons['C_vs_O']['call_reduction_pct'], -20)
        self.assertEqual(comparisons['A_vs_K']['call_reduction_pct'], -100)

