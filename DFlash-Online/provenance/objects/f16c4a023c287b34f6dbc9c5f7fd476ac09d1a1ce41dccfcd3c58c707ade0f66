def write(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(value) + '\n')


def write_lines(path, rows):
    path.write_text(''.join(json.dumps(row) + '\n' for row in rows))


def write_csv(path, rows):
    with path.open('w', newline='') as stream:
        output = csv.DictWriter(stream, fieldnames=list(rows[0]))
        output.writeheader()
        output.writerows(rows)


def fake_evaluation(root, requests, ordinary):
    """A complete null-call/mixed-time panel constructed only for auditor tests."""
    directory = root / 'evaluation'
    (directory / 'report').mkdir(parents=True)
    checkpoints = {'O': ordinary['checkpoint_path'], **{a: 'TEST_ONLY_' + a for a in audit.OBJECTIVES}}
    previous = audit.lines(OLD / 'evaluation/MEASUREMENTS.jsonl')
    retained, rows, activations = {}, [], []
    previous_arm = None
    for request in requests:
        rid, ordinal = request['request_id'], request['panel_ordinal']
        retained[rid] = {a: next(r['verification_calls'] for r in previous if r['request_id'] == rid and r['method'] == a) for a in ('F', 'O')}
        for repeat in range(3):
            original = next(r for r in previous if r['request_id'] == rid and r['method'] == 'O' and r['repeat'] == repeat)
            original_record = audit.read(OLD / 'evaluation' / f'{ordinal:04d}_r{repeat}_O.json')
            shift = (ordinal + repeat) % 4
            for arm in audit.ARMS[shift:] + audit.ARMS[:shift]:
                label = f'{ordinal:04d}_r{repeat}_{arm}'
                row, record = copy.deepcopy(original), copy.deepcopy(original_record)
                row.update(method=arm, checkpoint_id=checkpoints[arm], record_path='/TEST_FIXTURE/campaign_001/evaluation/' + label + '.json')
                record.update(record_id=label, checkpoint_id=checkpoints[arm])
                scale = {'O': 1., 'C': 1.2, 'K': .9, 'A': 1.3}[arm]
                row['request_latency_s'] *= scale
                record['metadata']['request_latency_s'] = row['request_latency_s']
                write(directory / (label + '.json'), record)
                rows.append(row)
                if arm != previous_arm:
                    activation = copy.deepcopy(audit.lines(OLD / 'evaluation/ACTIVATIONS.jsonl')[0])
                    activation.update(method=arm, panel_ordinal=ordinal, repeat=repeat, checkpoint_id=checkpoints[arm], activation_s=.01)
                    activation['native_status']['publication']['checkpoint_path'] = checkpoints[arm]
                    activations.append(activation)
                    previous_arm = arm
    for arm in audit.OBJECTIVES:
        write(root / arm / 'events/event_001/RESULT.json', dict(checkpoint_path=checkpoints[arm]))
    weights = []
    for arm in audit.ARMS:
        weight = copy.deepcopy(audit.read(OLD / 'evaluation/WEIGHTS_O.json'))
        weight['native_reply']['checkpoint_path'] = checkpoints[arm]
        weight['validation_s'] = .01
        write(directory / ('WEIGHTS_' + arm + '.json'), weight)
        weights.append(weight)
    status = dict(status='completed', planned_generations=768, attempted_generations=768, returned_generations=768,
        unknown_generation_attempts=0, unattempted_generations=0, qualification='passed', qualification_requests=8,
        optimizer_steps=0, feedback_collections=0, activation_s=sum(r['activation_s'] for r in activations),
        weight_validation_s=.04, evaluation_wall_s=1000.)
    protocol = dict(arms=list(audit.ARMS), comparisons=[list(p) for p in audit.PAIRS], required_arms=['O'],
        repeats=3, capture=False, count_trajectory_repeat=0, checkpoints=checkpoints, ordinary_counts=retained)
    ids = [r['request_id'] for r in requests]
    totals, comparisons = audit.independent_totals(rows, ids)
    summary = dict(planned_requests=64, valid_requests=64, invalid_or_incomplete_requests=0,
        returned_measurements=768, valid_timed_generations=768, timing_repeats_per_method_request=3,
        comparison_axes=dict(position_selection=['K_vs_O', 'A_vs_C'], loss_choice=['C_vs_O', 'A_vs_K']),
        **totals, comparisons=comparisons, execution=status)
    write(directory / 'PROTOCOL.json', protocol)
    write(directory / 'STATUS.json', status)
    write(directory / 'QUALIFICATION.json', dict(status='passed', requests=8, generations=96,
        arms_with_native_equality=sorted(audit.ARMS), performance_win_required=False))
    write(directory / 'report/SUMMARY.json', summary)
    write(directory / 'report/HISTORICAL_F_COUNTS.json', dict(source='retained first-event F measurements; not fresh latency',
        valid_requests=64, verification_calls=sum(r['F'] for r in retained.values()), per_request={r: retained[r]['F'] for r in ids}))
    write_lines(directory / 'MEASUREMENTS.jsonl', rows)
    write_lines(directory / 'ACTIVATIONS.jsonl', activations)
    per_request = []
    for request in requests:
        rid = request['request_id']
        result = dict(request_id=rid, complete=True, valid=True, errors='')
        for arm in audit.ARMS:
            group = [r for r in rows if r['request_id'] == rid and r['method'] == arm]
            primary = next(r for r in group if r['repeat'] == 0)
            for name in audit.COUNTS:
                result[arm + '_' + name] = primary[name]
            result[arm + '_mean_request_latency_s'] = sum(r['request_latency_s'] for r in group)/3
            result[arm + '_calls_per_1000_output_tokens'] = 1000*primary['verification_calls']/primary['output_tokens']
            result[arm + '_accepted_draft_tokens_per_call'] = primary['accepted_draft_tokens']/primary['verification_calls']
            result[arm + '_committed_progress_per_call'] = primary['committed_progress']/primary['verification_calls']
        for candidate, reference in audit.PAIRS:
            label = candidate + '_vs_' + reference
            for metric, key, reduction in (('call', 'verification_calls', 'call_reduction_pct'), ('latency', 'mean_request_latency_s', 'request_time_reduction_pct')):
                before, after = result[reference + '_' + key], result[candidate + '_' + key]
                result[label + '_' + reduction] = 100*(1-after/before)
                result[label + '_' + metric + '_direction'] = 'improved' if after < before else 'regressed' if after > before else 'tied'
        per_request.append(result)
    write_csv(directory / 'report/PER_REQUEST.csv', per_request)
    write_csv(directory / 'report/ALL_REPEATS.csv', [{**r, 'report_valid': True, 'report_errors': []} for r in rows])
    write_csv(directory / 'report/REPEAT_TOTALS.csv', [dict(repeat=i, method=a, requests=64,
        verification_calls=sum(r['verification_calls'] for r in rows if r['repeat'] == i and r['method'] == a),
        request_latency_s=sum(r['request_latency_s'] for r in rows if r['repeat'] == i and r['method'] == a))
        for i in range(3) for a in audit.ARMS])
    ordinary_rows = [r for r in previous if r['method'] in ('F', 'O')]
    return ordinary_rows


def fake_training(root, ordinary):
    features = {r['record_id']: r for r in ordinary['features']}
    for arm, objective in audit.OBJECTIVES.items():
        rows, pending = [], []
        for original in ordinary['records']:
            row = copy.deepcopy(original)
            feature = features[row['record_id']]
            slots = anchors = positions = 0
            weight = 0.
            for draw in row['sampled_anchors']:
                for sampled, keep in zip(draw['positions'], draw['keep_mask']):
                    slots += len(sampled)
                    for anchor, active in zip(sampled, keep):
                        if active:
                            anchors += 1
                            offsets = [j for j in range(1, 16) if anchor+j < feature['length']]
                            positions += len(offsets)
                            weight += sum(math.exp(-(j-1)/7) for j in offsets)
            pending.append((slots, anchors, positions, weight))
            nslots, nanchors, npositions, nweight = [sum(v[j] for v in pending) for j in range(4)]
            selected, selected_weight = (npositions, nweight) if arm == 'C' else (nanchors, nanchors)
            denominator = selected_weight + len(pending)*1e-6
            m = dict(available_position_occurrences=npositions, selected_position_occurrences=selected,
                available_position_weight=nweight, selected_position_weight=selected_weight,
                no_error_blocks=nanchors if arm == 'C' else 0, empty_blocks=nslots-nanchors,
                main_loss_numerator=2*denominator, loss_denominator=denominator,
                response_presentations=len(pending), supervised_position_exposure=selected,
                objective_loss=2., **{name: nanchors if arm != 'C' and i == 0 else 0 for i, name in enumerate(audit.HISTOGRAM)})
            m['canonical_ce' if arm in ('C', 'A') else 'forward_kl'] = 2.
            row.update(metrics=m, metrics_scope='accumulation_window' if row['optimizer_stepped'] else 'presentation', training_s=.1)
            rows.append(row)
            if row['optimizer_stepped']:
                pending = []
        work = dict(reference_setup_s=0., reference_forward_s=0., reference_head_s=0., projection_s=0.,
                    teacher_head_s=0. if arm in ('C', 'A') else 1., selection_s=1.)
        event = dict(status='completed', objective=objective, reduction='response_mean', passes=2, optimizer_steps=128,
            response_presentations=256, start_step=0, end_step=128,
            selection_totals_source='optimizer_boundary_accumulation_windows_once', gradient_denominator='responses per accumulation window',
            records=rows, features=ordinary['features'], selection_totals=audit.diagnostic_totals(rows)['sums'], objective_work=work,
            costs=dict(training_s=sum(r['training_s'] for r in rows), checkpoint_save_s=1., export_s=1.))
        write(root / arm / 'events/event_001/RESULT.json', event)
        initialization = dict(exact_pinned_initial_state=True, full_rng_restored_after_construction=True,
                              inherited_warmup_state=False, reference_created=False, wall_s=1.)
        write(root / (arm + '_INITIAL.json'), dict(global_step=0, presentations=0, accumulation_remainder=0,
            completed_events=[], closed=False, failed=False, objective=objective, reduction='response_mean', controlled_initialization=initialization))
        write(root / (arm + '_CLOSED.json'), dict(global_step=128, presentations=256, accumulation_remainder=0,
            completed_events=['event_001'], closed=True, failed=False))
        write(root / arm / 'initialization/initial_vs_pinned.json', dict(exact_equal=True,
            missing_left=[], missing_right=[], metadata_differences=[], tensor_differences=[]))


class AuditEvidenceTests(unittest.TestCase):
