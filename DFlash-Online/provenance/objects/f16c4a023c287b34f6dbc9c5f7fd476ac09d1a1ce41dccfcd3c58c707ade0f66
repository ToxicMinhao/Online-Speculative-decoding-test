        cls.root = Path(cls.temporary.name)
        cls.ordinary = audit.read(ORDINARY)
        cls.requests = audit.read(OLD / 'MANIFEST.json')['eval_requests']
        cls.trace = audit.load_trace_auditor(audit.DEFAULT_TRACE_AUDITOR)
        cls.ordinary_rows = fake_evaluation(cls.root / 'panel', cls.requests, cls.ordinary)
        fake_training(cls.root / 'training', cls.ordinary)

    @classmethod
    def tearDownClass(cls):
        cls.temporary.cleanup()

    def test_complete_768_panel_null_calls_and_harmful_time_pass(self):
        issues = []
        result = audit.evaluation(self.root / 'panel', self.requests, self.ordinary_rows, self.ordinary, self.trace, issues)
        self.assertEqual(issues, [])
        self.assertEqual(result['raw_measurements'], 768)
        self.assertEqual(result['historical_F_calls'], 3140)
        self.assertEqual(set(result['comparisons']), {'K_vs_O', 'A_vs_C', 'C_vs_O', 'A_vs_K'})
        self.assertEqual(result['comparisons']['C_vs_O']['call_reduction_pct'], 0)
        self.assertLess(result['comparisons']['C_vs_O']['request_time_reduction_pct'], 0)

