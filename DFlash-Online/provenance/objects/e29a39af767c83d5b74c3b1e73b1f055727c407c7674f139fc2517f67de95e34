"""CPU-only contracts for native token provenance and fail-closed publication."""
import contextlib
import copy
import hashlib
import json
from pathlib import Path
import tempfile
import types
import unittest
from unittest.mock import Mock, patch

import online_feedback.buffer as buffer_module
from online_feedback.buffer import token_sha256
from online_feedback.native import NativeDFlashBackend, atomic_json, validate_publication


class FakeTensor:
    def __init__(self, shape=(2, 3), dtype="bfloat16", finite=True):
        self.shape, self.dtype, self.finite = shape, dtype, finite


class FakeMask:
    def __init__(self, finite):
        self.finite = finite
    def all(self):
        return self.finite


class FakeConfig:
    vocab_size = 1000
    def __init__(self, **changes):
        self.fields = {"hidden_size": 3, "num_hidden_layers": 1, "rope_theta": 10000,
                       "dflash_config": {"block_size": 16, "mask_token_id": 7},
                       "_name_or_path": "released", "dtype": "bfloat16",
                       "transformers_version": "old", "architectures": ["DFlashDraftModel"]}
        self.fields.update(changes)
    def to_dict(self):
        return copy.deepcopy(self.fields)


class FakeDraft:
    def __init__(self):
        self.config = FakeConfig()
        self.block_size, self.mask_token_id, self.target_layer_ids = 16, 7, [1, 3, 5]
        self.state = {"layers.0.weight": FakeTensor(), "norm.weight": FakeTensor((3,))}
        self.grad_enabled = False
    def state_dict(self):
        return self.state
    def to(self, device):
        return self
    def eval(self):
        return self
    def requires_grad_(self, enabled):
        self.grad_enabled = enabled
        return self


def loading_info():
    return dict(missing_keys=[], unexpected_keys=[], mismatched_keys=[], error_msgs=[])


def validate(candidate, current=None, info=None):
    return validate_publication(candidate, current or FakeDraft(),
                                loading_info() if info is None else info,
                                tensor_isfinite=lambda value: value.finite)


class NativeContractTests(unittest.TestCase):
    def test_compatible_export_allows_provenance_changes(self):
        new = FakeDraft()
        new.config.fields.update(_name_or_path="event/export", transformers_version="new",
                                 architectures=["SpecForgeDFlash"], dtype="float32")
        receipt = validate(new)
        self.assertEqual(receipt["tensor_count"], 2)
        self.assertTrue(receipt["strict_loading"])
        self.assertTrue(receipt["all_tensors_finite"])

    def test_all_partial_loading_diagnostics_are_rejected(self):
        for key in loading_info():
            bad = loading_info()
            bad[key] = ["layers.0.weight"]
            with self.subTest(key=key), self.assertRaises(ValueError):
                validate(FakeDraft(), info=bad)
        for missing in loading_info():
            bad = loading_info()
            del bad[missing]
            with self.subTest(missing=missing), self.assertRaises(ValueError):
                validate(FakeDraft(), info=bad)

    def test_forward_configuration_changes_are_rejected(self):
        for field, value in (("rope_theta", 20000), ("hidden_size", 4),
                             ("dflash_config", {"block_size": 16, "mask_token_id": 8})):
            new = FakeDraft()
            new.config.fields[field] = value
            with self.subTest(field=field), self.assertRaises(ValueError):
                validate(new)
        for field, value in (("block_size", 8), ("mask_token_id", 8),
                             ("target_layer_ids", [2, 3, 5])):
            new = FakeDraft()
            setattr(new, field, value)
            with self.subTest(field=field), self.assertRaises(ValueError):
                validate(new)


    def test_qwen_dflash_implicit_vocab_default_matches_export_bidirectionally(self):
        released, exported = FakeDraft(), FakeDraft()
        for model in (released, exported):
            model.config.fields.update(model_type="qwen3", vocab_size=151936)
        exported.config.fields["draft_vocab_size"] = 151936
        forward = validate(exported, current=released)
        backward = validate(released, current=exported)
        self.assertEqual(forward["semantic_config_sha256"],
                         backward["semantic_config_sha256"])
        self.assertNotIn("draft_vocab_size", released.config.fields)

    def test_explicit_changed_or_null_draft_vocab_is_still_rejected(self):
        released = FakeDraft()
        released.config.fields.update(model_type="qwen3", vocab_size=151936)
        for value in (151935, None, True, "151936"):
            exported = copy.deepcopy(released)
            exported.config.fields["draft_vocab_size"] = value
            with self.subTest(value=value), self.assertRaises(ValueError):
                validate(exported, current=released)

    def test_vocab_default_normalization_does_not_apply_to_other_config_families(self):
        for model_type, dflash_config in (("llama", {"mask_token_id": 7}),
                                         ("qwen3", None)):
            released, exported = FakeDraft(), FakeDraft()
            for model in (released, exported):
                model.config.fields.update(model_type=model_type, vocab_size=151936,
                                           dflash_config=dflash_config)
            exported.config.fields["draft_vocab_size"] = 151936
            with self.subTest(model_type=model_type, dflash=dflash_config):
                with self.assertRaises(ValueError):
                    validate(exported, current=released)

    def test_other_semantic_changes_remain_rejected_after_vocab_normalization(self):
        released = FakeDraft()
        released.config.fields.update(model_type="qwen3", vocab_size=151936)
        for field, value in (("vocab_size", 151935), ("rope_theta", 20000),
                             ("attention_dropout", 0.1), ("hidden_size", 4)):
            exported = copy.deepcopy(released)
            exported.config.fields["draft_vocab_size"] = 151936
            exported.config.fields[field] = value
            with self.subTest(field=field), self.assertRaises(ValueError):
                validate(exported, current=released)

    def test_state_keys_shapes_dtypes_and_values_must_match_contract(self):
        mutations = (
            lambda state: state.pop("norm.weight"),
            lambda state: state.update(extra=FakeTensor()),
            lambda state: state.update(**{"norm.weight": FakeTensor((4,))}),
            lambda state: state.update(**{"norm.weight": FakeTensor((3,), "float32")}),
            lambda state: state.update(**{"norm.weight": FakeTensor((3,), finite=False)}),
        )
        for index, mutation in enumerate(mutations):
            new = FakeDraft()
            mutation(new.state)
            with self.subTest(index=index), self.assertRaises((ValueError, FloatingPointError)):
                validate(new)

    def backend(self):
        backend = NativeDFlashBackend.__new__(NativeDFlashBackend)
        backend.device, backend.context_limit, backend.block_size = "fake-cpu", 64, 16
        backend.draft = FakeDraft()
        backend.target = FakeDraft()
        backend.checkpoint_id, backend.stop_tokens = "old", [2]
        backend.torch = types.SimpleNamespace(
            bfloat16="bfloat16", long="long",
            cuda=types.SimpleNamespace(synchronize=Mock()),
            isfinite=lambda value: FakeMask(value.finite),
            tensor=lambda values, **kwargs: values,
        )
        backend.assert_target_unchanged = Mock()
        backend._checkpoint_identity = Mock(return_value="new")
        return backend

    @contextlib.contextmanager
    def fake_dflash(self, **attributes):
        package = types.ModuleType("dflash")
        model = types.ModuleType("dflash.model")
        for key, value in attributes.items():
            setattr(model, key, value)
        package.model = model
        with patch.dict("sys.modules", {"dflash": package, "dflash.model": model}):
            with patch("online_feedback.native.preserve_rng", contextlib.nullcontext):
                yield

    def test_publish_requests_strict_loading_and_activates_only_after_validation(self):
        backend, candidate = self.backend(), FakeDraft()
        loader = Mock(return_value=(candidate, loading_info()))
        with self.fake_dflash(DFlashDraftModel=types.SimpleNamespace(from_pretrained=loader)):
            receipt = backend.publish("/unused/export")
        self.assertTrue(loader.call_args.kwargs["output_loading_info"])
        self.assertIs(backend.draft, candidate)
        self.assertEqual(backend.checkpoint_id, "new")
        self.assertFalse(candidate.grad_enabled)
        self.assertTrue(receipt["publication_validation"]["all_tensors_finite"])
        self.assertTrue(receipt["checkpoint_rehashed_after_load"])
        self.assertEqual(backend._checkpoint_identity.call_count, 2)

    def test_failed_publication_keeps_previous_draft_and_identity(self):
        for cause in ("missing", "nonfinite", "changed_files", "target", "synchronize"):
            backend, candidate = self.backend(), FakeDraft()
            old = backend.draft
            info = loading_info()
            if cause == "missing":
                info["missing_keys"] = ["norm.weight"]
            elif cause == "nonfinite":
                candidate.state["norm.weight"].finite = False
            elif cause == "changed_files":
                backend._checkpoint_identity.side_effect = ["before", "after"]
            elif cause == "target":
                backend.assert_target_unchanged.side_effect = RuntimeError("target changed")
            elif cause == "synchronize":
                backend.torch.cuda.synchronize.side_effect = RuntimeError("device failure")
            loader = Mock(return_value=(candidate, info))
            with self.subTest(cause=cause):
                with self.fake_dflash(DFlashDraftModel=types.SimpleNamespace(from_pretrained=loader)):
                    with self.assertRaises((ValueError, RuntimeError, FloatingPointError)):
                        backend.publish("/unused/export")
                self.assertIs(backend.draft, old)
                self.assertEqual(backend.checkpoint_id, "old")

    def test_generation_hashes_bind_prompt_response_and_combined_input(self):
        backend = self.backend()
        prompt = [101, 102]
        response = [31, 2]
        trace = dict(output_start=0, anchor_token=31, committed_progress=1,
                     committed_tokens=[2], accepted_draft_tokens=0)
        def generate(*args, **kwargs):
            kwargs["trace_callback"](trace)
            return types.SimpleNamespace(
                output_ids=[types.SimpleNamespace(tolist=lambda: prompt + response)],
                time_to_first_token=0.1)
        with self.fake_dflash(dflash_generate=generate):
            result = backend.generate(prompt, max_new_tokens=4, request_id="r",
                                      session_id="s", request_index=0)
        metadata = result["metadata"]
        self.assertEqual(metadata["prompt_sha256"], token_sha256(prompt))
        self.assertEqual(metadata["response_sha256"], token_sha256(response))
        self.assertEqual(metadata["input_sha256"], token_sha256(prompt + response))
        self.assertEqual(result["response_ids"], response)
        self.assertEqual(metadata["verification_calls"], 1)

    def test_atomic_receipt_persists_nested_directories_and_previous_state_on_failure(self):
        with tempfile.TemporaryDirectory(prefix="native_contract_") as temporary:
            root = Path(temporary)
            path = root / "new" / "events" / "receipt.json"
            with patch("online_feedback.buffer._fsync_dir", wraps=buffer_module._fsync_dir) as sync:
                atomic_json(path, {"status": "sealed"})
            synced = {call.args[0] for call in sync.call_args_list}
            self.assertTrue({root, root / "new", path.parent}.issubset(synced))
            with patch("online_feedback.buffer.os.replace", side_effect=OSError("interrupted")):
                with self.assertRaises(OSError):
                    atomic_json(path, {"status": "committed"})
            self.assertEqual(json.loads(path.read_text()), {"status": "sealed"})
            self.assertEqual([p.name for p in path.parent.iterdir()], ["receipt.json"])


