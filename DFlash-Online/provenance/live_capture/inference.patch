 def _make_cache(config):
     cache = DynamicCache(config=config)
-    cache.activate_past_recording()
+    if hasattr(cache, "activate_past_recording"):
+        cache.activate_past_recording()
+    else:
+        # Transformers 5.12.1 has append-only DynamicLayer caches whose crop()
+        # argument is an absolute length (zero empties the cache). The upstream
+        # recording-cache path below uses relative rewind semantics instead.
+        # Admit only the full-attention Qwen3 contract verified for this runtime.
+        from transformers.cache_utils import DynamicLayer
+
+        layer_types = getattr(config, "layer_types", None)
+        num_layers = getattr(config, "num_hidden_layers", None)
+        if (
+            not isinstance(config, Qwen3Config)
+            or config.model_type != "qwen3"
+            or getattr(config, "use_sliding_window", False)
+            or getattr(config, "sliding_window", None) is not None
+            or getattr(config, "attention_chunk_size", None) is not None
+            or getattr(config, "num_kv_shared_layers", 0) != 0
+            or type(num_layers) is not int
+            or num_layers <= 0
+            or layer_types != ["full_attention"] * num_layers
+            or len(cache.layers) != num_layers
+            or any(type(layer) is not DynamicLayer for layer in cache.layers)
+        ):
+            raise ValueError(
+                "Legacy DFlash cache compatibility requires full-attention Qwen3 "
+                "without sliding, chunked, hybrid, or shared cache layers"
+            )
+        cache._dflash_legacy_absolute_crop = True
     return cache
 
 
 def _crop_to(cache, length):
+    if getattr(cache, "_dflash_legacy_absolute_crop", False):
+        current = cache.get_seq_length()
+        if type(length) is not int or not 0 <= length <= current:
+            raise ValueError(
+                f"Legacy cache crop must keep 0..{current} tokens, got {length!r}"
+            )
+        cache.crop(length)
+        return
     remove = cache.get_seq_length() - length
     cache.crop(-remove)
 
